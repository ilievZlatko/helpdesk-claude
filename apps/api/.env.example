# development | test | production. Defaults to development; must be
# production when BETTER_AUTH_URL is https (`pnpm start:prod` sets it).
# NODE_ENV=development

# Port the API listens on
PORT=3000

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5433/helpdesk

# better-auth: secret (min 32 chars; generate with `openssl rand -base64 32`),
# the API's public base URL, and the web app origin trusted for auth requests
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Where the real client IP comes from, for sign-in rate limiting. Production
# requires one of them; leave both unset locally.
# - the header your host sets to the client IP (clients can't forge it):
# CLIENT_IP_HEADER=fly-client-ip
# - or the proxies in front of the API (comma-separated IPs/CIDRs):
# TRUSTED_PROXIES=10.0.0.0/8

# Admin account guaranteed by `pnpm db:seed` (created if missing; given the
# admin role if it exists). These are dev defaults: production rejects an
# @example.com email and requires a non-default password of 16+ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123

# Password for the dev users created by `pnpm db:seed` and the e2e tests
# (min 8 chars). Dev/test only: the API refuses to start in production
# when it is set.
SEED_USER_PASSWORD=helpdesk-dev-password
