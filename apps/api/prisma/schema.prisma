// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL is configured in prisma7.config.ts (from DATABASE_URL).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}
